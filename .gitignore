# =============================================================================
# PyroLens .gitignore
# =============================================================================

# Environment & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
.vault/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
ENV/
env/
backend/.venv/
backend/*.db
backend/*.db-journal
backend/pyrolens.db

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
.next-dev/
*.local

# Vite
.vite/

# Docker
.docker/
docker-compose.override.yml

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# OS
*.log
*.tmp
*.temp
*.bak
*.backup

# Model Artifacts (generated)
backend/artifacts/*.joblib
backend/artifacts/*.pkl
backend/artifacts/*.model

# Data Files (large OSM/PBF files)
*.pbf
*.osm
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg

# Coverage / Test Reports
coverage/
.nyc_output/
junit.xml

# TypeScript
*.tsbuildinfo

# Render / Deployment
render.yaml.bak