# Use development only for the demo. Set ENVIRONMENT=production and configure
# an external identity provider before deploying.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://pyrolens:pyrolens@postgres:5432/pyrolens
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
JWT_SECRET=replace-with-a-long-random-secret
OBJECT_STORE_ENDPOINT=minio:9000
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio123
OBJECT_STORE_BUCKET=pyrolens-assets
# FIRMS_API_KEY=your-nasa-firms-map-key
FIRMS_SOURCE=VIIRS_NOAA21_NRT
FIRMS_DEFAULT_BBOX=77.30,23.05,77.55,23.35
MONITORING_AREA_NAME=Bhopal, Madhya Pradesh
MONITORING_LATITUDE=23.2599
MONITORING_LONGITUDE=77.4126
FIRMS_DAYS=1
FIRMS_REFRESH_SECONDS=300
USE_CELERY=true
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
OSM_LIVE_ENABLED=true
# TERRAIN_RASTER_PATH=/data/terrain.tif
# LANDCOVER_RASTER_PATH=/data/landcover.tif
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=pyrolens-api
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15551234567
# SMTP_HOST=smtp.example.com
# SMTP_USERNAME=...
# SMTP_PASSWORD=...
# SMTP_FROM_ADDRESS=alerts@example.com
