# PyroLens Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP_NAME="PyroLens Intelligence API"
ENVIRONMENT=development
PUBLIC_READ_API=false
MODEL_VERSION=xgboost-synthetic-v1
MODEL_PATH=artifacts/fire_classifier.joblib
API_PREFIX=/api/v1

# =============================================================================
# DATABASE (SQLite for local dev, PostgreSQL/PostGIS for Docker/production)
# =============================================================================
# Local development (SQLite):
DATABASE_URL=sqlite:///./pyrolens.db

# Docker Compose (PostGIS) - uncomment when using docker compose:
# DATABASE_URL=postgresql+psycopg://pyrolens:pyrolens@postgres:5432/pyrolens

# Production (managed PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# =============================================================================
# REDIS / CELERY
# =============================================================================
# Local development:
REDIS_URL=redis://localhost:6379/0

# Docker Compose:
# REDIS_URL=redis://redis:6379/0

# Production (managed Redis):
# REDIS_URL=redis://user:password@host:6379/0

# Enable Celery worker for background tasks (Docker/production)
USE_CELERY=false

# Auto-refresh FIRMS on startup (for demo deployments without Celery)
AUTO_REFRESH_FIRMS_ON_START=false

# Celery always eager mode (run tasks synchronously, for testing)
CELERY_TASK_ALWAYS_EAGER=false

# =============================================================================
# NASA FIRMS (Fire Information for Resource Management System)
# =============================================================================
# Get a free MAP_KEY at: https://firms.modaps.eosdis.nasa.gov/api/map_key
FIRMS_API_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_SOURCE=VIIRS_NOAA21_NRT
# Bounding box: west,south,east,north (WGS84) - Central Africa pilot area
FIRMS_DEFAULT_BBOX=22.0,-15.0,32.0,-8.0
FIRMS_DAYS=1
# Refresh interval in seconds (300 = 5 minutes)
FIRMS_REFRESH_SECONDS=300

# =============================================================================
# WEATHER PROVIDER (Open-Meteo - free, no key required)
# =============================================================================
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# =============================================================================
# OPENSTREETMAP / OVERPASS
# =============================================================================
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_LIVE_ENABLED=true

# =============================================================================
# MONITORING AREA (for operational dashboard)
# =============================================================================
MONITORING_AREA_NAME=Malawi fire monitoring area
MONITORING_LATITUDE=-9.38
MONITORING_LONGITUDE=33.01

# =============================================================================
# TERRAIN / LANDCOVER RASTERS (optional, for advanced impact analysis)
# =============================================================================
# Mount GeoTIFF files and set paths to enable wind-oriented impact zones
TERRAIN_RASTER_PATH=
LANDCOVER_RASTER_PATH=

# =============================================================================
# OBJECT STORAGE (MinIO / S3 compatible)
# =============================================================================
# Local MinIO (Docker Compose):
OBJECT_STORE_ENDPOINT=minio:4566
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minio123
OBJECT_STORE_BUCKET=pyrolens-assets
OBJECT_STORE_SECURE=false

# Production S3:
# OBJECT_STORE_ENDPOINT=s3.amazonaws.com
# OBJECT_STORE_ACCESS_KEY=your-access-key
# OBJECT_STORE_SECRET_KEY=your-secret-key
# OBJECT_STORE_BUCKET=your-bucket
# OBJECT_STORE_SECURE=true

# =============================================================================
# AUTHENTICATION / JWT
# =============================================================================
# CHANGE THIS IN PRODUCTION! Use a strong random secret (32+ chars)
JWT_SECRET=development-only-change-me-in-production
JWT_ALGORITHM=HS256

# OIDC / External Identity Provider (production)
# Configure these to enable RS256 token validation from Keycloak, Auth0, etc.
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=

# =============================================================================
# ALERTS (Twilio SMS / SMTP Email)
# =============================================================================
ALERT_PROVIDER=log

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# =============================================================================
# CORS
# =============================================================================
# Comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

# =============================================================================
# CELERY (Worker/Scheduler)
# =============================================================================
# These are set by docker-compose.yml for worker/scheduler services
# DATABASE_URL, REDIS_URL, OBJECT_STORE_ENDPOINT, USE_CELERY