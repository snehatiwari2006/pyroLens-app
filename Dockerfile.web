# Multi-stage build for production frontend served by nginx
# Stage 1: Build the React/Vite application
FROM node:20-alpine AS builder

WORKDIR /web

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build arguments for API URL (use relative path so nginx proxies to backend container)
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine AS runner

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder stage
COPY --from=builder /web/dist /usr/share/nginx/html

# Add favicon.ico as physical file (fallback for exact match location)
RUN echo '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="45" fill="#dc2626"/><path d="M50 15 L50 85 M35 50 L65 50" stroke="white" stroke-width="8" stroke-linecap="round"/></svg>' > /usr/share/nginx/html/favicon.ico

# Add health check endpoint
RUN echo 'server { listen 80; location /health { return 200 "healthy\n"; add_header Content-Type text/plain; } }' > /etc/nginx/conf.d/health.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]